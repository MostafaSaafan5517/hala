# Copy to .env.local and fill in, or run `pnpm env:local` with local Supabase running to write
# the Supabase values for you. Never commit real values.

# Supabase: the project URL and its publishable (browser-safe) key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key: bypasses Row-Level Security, server code only.
SUPABASE_SECRET_KEY=

# AI models, through the Vercel AI Gateway (https://vercel.com/ai-gateway): one key for every
# provider. Not needed with EMBEDDING_MODEL=offline. On Vercel, the deployment's OIDC token is
# used instead of a key.
AI_GATEWAY_API_KEY=
# The embedding model for knowledge retrieval: "openai/text-embedding-3-small", or "offline" (a
# word-matching stand-in that needs no key, used by the tests). `pnpm env:local` sets "offline"
# when this is missing. Changing it means re-indexing the knowledge base (Knowledge tab).
EMBEDDING_MODEL=offline
# The assistant's chat model: "anthropic/claude-sonnet-5.5" (the default for real use),
# "anthropic/claude-haiku-4.5", "openai/gpt-5.4-mini", or "offline" (a rule-based stand-in that
# answers from the knowledge base and needs no key, used by the tests). `pnpm env:local` sets
# "offline" when this is missing.
CHAT_MODEL=offline
# Signs the assistant's approval requests (booking, moving, cancelling) so only what the customer
# really approved runs. At least 32 random characters, the same on every server instance:
# `openssl rand -base64 32`. `pnpm env:local` generates one when this is missing.
TOOL_APPROVAL_SECRET=
