# Copy to .env.local and fill in, or run `pnpm env:local` with local Supabase running to write
# the Supabase values for you. Never commit real values.

# Supabase: the project URL and its publishable (browser-safe) key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key: bypasses Row-Level Security, server code only.
SUPABASE_SECRET_KEY=

# AI models, through the Vercel AI Gateway (https://vercel.com/ai-gateway): one key for every
# provider. Not needed with EMBEDDING_MODEL=offline. On Vercel, the deployment's OIDC token is
# used instead of a key.
AI_GATEWAY_API_KEY=
# The embedding model for knowledge retrieval: "cohere/embed-v4.0" (the default for real use, on
# the AI Gateway's free tier), "openai/text-embedding-3-small" (needs paid credit), or "offline" (a
# word-matching stand-in that needs no key, used by the tests). `pnpm env:local` sets "offline"
# when this is missing. Changing it means re-indexing the knowledge base (Knowledge tab).
EMBEDDING_MODEL=offline
# The assistant's chat model. On the AI Gateway's free tier: "openai/gpt-5-mini" (the default for
# real use: best on the evaluation suite), "openai/gpt-4.1-mini" (faster, a little less careful)
# or "google/gemini-2.5-flash". With paid credit: "anthropic/claude-haiku-4.5",
# "anthropic/claude-sonnet-5.5" or "openai/gpt-5.4-mini". "inclusionai/ling-3.1-flash-free" is free
# but makes no data-retention promises (tests and evaluations only), and "offline" is a rule-based
# stand-in that answers from the knowledge base and needs no key (used by the tests). `pnpm env:local` sets "offline" when
# this is missing.
CHAT_MODEL=offline
# Daily AI spending limits, in US dollars. Each business's local day (default 5), and the whole
# deployment's UTC day, every business together (no limit when empty). Over either, customers get
# a fixed reply and the conversation goes to a person. The public demo keeps both small, inside
# the AI Gateway's free credit ($5 every 30 days).
BUSINESS_DAILY_BUDGET_USD=
SITE_DAILY_BUDGET_USD=
# Signs the assistant's approval requests (booking, moving, cancelling) so only what the customer
# really approved runs. At least 32 random characters, the same on every server instance:
# `openssl rand -base64 32`. `pnpm env:local` generates one when this is missing.
TOOL_APPROVAL_SECRET=
